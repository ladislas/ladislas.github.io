---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import ClarityToggle from '../components/ClarityToggle.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Notes from the quiet edge of building things.',
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Inline: apply saved theme/clarity before first paint to prevent flash -->
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('wt-theme') || 'dark';
          var c = localStorage.getItem('wt-clarity');
          document.documentElement.setAttribute('data-theme', t);
          if (c === 'high') document.documentElement.setAttribute('data-clarity', 'high');
        } catch (_) {}
      })();
    </script>
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" title="Workshop Terminal RSS" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,700;1,9..144,700&family=IBM+Plex+Mono:wght@400;500&family=Instrument+Sans:wght@400;500;600;700&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap"
    />
  </head>
  <body>
    <header class="site-header">
      <div class="shell">
        <a class="site-title" href="/">Workshop Terminal</a>
        <nav class="site-nav" aria-label="Primary">
          <a href="/logs/">Logs</a>
          <a href="/projects/">Projects</a>
          <a href="/routes/">Routes</a>
          <a href="/rss.xml">RSS</a>
        </nav>
        <div class="site-controls">
          <ThemeToggle />
          <ClarityToggle />
        </div>
      </div>
    </header>

    <main class="shell">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="shell">
        <p>Static by default with Astro, MDX, and GitHub Pages.</p>
      </div>
    </footer>
  </body>
</html>
