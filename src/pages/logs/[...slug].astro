---
import { getCollection, getEntries, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, isPublishedLog } from '../../lib/content';

export async function getStaticPaths() {
  const logs = (await getCollection('logs')).filter(isPublishedLog);

  return logs.map((log) => ({
    params: { slug: log.id },
    props: { log },
  }));
}

const { log } = Astro.props;
const route = await getEntry('routes', log.data.primaryRoute);

if (!route) {
  throw new Error(`Missing route entry '${log.data.primaryRoute}' for Log '${log.id}'.`);
}

const relatedProjects = await getEntries(log.data.relatedProjects);
const { Content } = await render(log);
---

<BaseLayout
  title={`${log.data.title} | Workshop Terminal`}
  description={log.data.summary}
>
  <article class="prose">
    <p class="eyebrow">Log</p>
    <h1>{log.data.title}</h1>
    <p class="lede">{log.data.subtitle}</p>
    <p>{log.data.summary}</p>
    <p class="meta">
      <span>Type: {log.data.type}</span>
      <span>Published {formatDate(log.data.publishedAt)}</span>
      <span>Route: <a href={`/routes/${route.id}/`}>{route.data.title}</a></span>
      {log.data.updatedAt && <span>Updated {formatDate(log.data.updatedAt)}</span>}
    </p>

    {log.data.updatedAt && log.data.revisionNote && (
      <p class="meta">Revision note: {log.data.revisionNote}</p>
    )}

    {log.data.tags.length > 0 && (
      <ul class="tag-list" aria-label="Tags">
        {log.data.tags.map((tag) => (
          <li class="tag">{tag}</li>
        ))}
      </ul>
    )}

    <Content />

    {log.data.relatedLinks.length > 0 && (
      <section class="panel">
        <h2>Related Links</h2>
        <ul>
          {log.data.relatedLinks.map((link) => (
            <li>
              <a href={link.url}>{link.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {log.data.discussionUrl && (
      <section class="panel">
        <h2>Discussion</h2>
        <p>
          <a href={log.data.discussionUrl}>Join the GitHub Discussion</a>
        </p>
      </section>
    )}

    {relatedProjects.length > 0 && (
      <section class="panel">
        <h2>Related Projects</h2>
        <ul>
          {relatedProjects.map((project) => (
            <li>
              <a href={`/projects/${project.id}/`}>{project.data.title}</a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>
