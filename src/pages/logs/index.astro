---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatDate,
  isPublishedLog,
  sortLogsByDateDesc,
  sortRoutesByOrder,
} from '../../lib/content';

const logs = (await getCollection('logs')).filter(isPublishedLog).sort(sortLogsByDateDesc);
const routes = (await getCollection('routes')).sort(sortRoutesByOrder);
const routesById = new Map(routes.map((route) => [route.id, route]));
---

<BaseLayout title="Logs | Workshop Terminal" description="Published Logs.">
  <section class="hero">
    <p class="eyebrow">Logs</p>
    <h1>Published Logs</h1>
    <p class="lede">Typed frontmatter, MDX when needed, and static output by default.</p>
  </section>

  <section>
    <ul class="card-grid">
      {logs.map((log) => (
        <li class="card">
          <p class="eyebrow">{log.data.type}</p>
          <h2>
            <a href={`/logs/${log.id}/`}>{log.data.title}</a>
          </h2>
          <p>{log.data.summary}</p>
          <p class="meta">
            <span>{formatDate(log.data.publishedAt)}</span>
            <span>Route: {routesById.get(log.data.primaryRoute)?.data.title ?? log.data.primaryRoute}</span>
          </p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
