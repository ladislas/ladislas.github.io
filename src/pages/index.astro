---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  formatDate,
  isPublishedLog,
  isPublishedProject,
  sortLogsByDateDesc,
  sortProjectsByUpdatedDesc,
  sortRoutesByOrder,
} from '../lib/content';

const logs = (await getCollection('logs')).filter(isPublishedLog).sort(sortLogsByDateDesc);
const projects = (await getCollection('projects'))
  .filter(isPublishedProject)
  .sort(sortProjectsByUpdatedDesc);
const routes = (await getCollection('routes')).sort(sortRoutesByOrder);
const routesById = new Map(routes.map((route) => [route.id, route]));
---

<BaseLayout
  title="Workshop Terminal"
  description="Notes from the quiet edge of building things."
>
  <section class="hero">
    <p class="eyebrow">Technical foundation</p>
    <h1>Workshop Terminal</h1>
    <p class="lede">
      A static-first Astro site with typed content collections, MDX support, RSS,
      and a GitHub Pages deployment path.
    </p>
  </section>

  <section>
    <div class="panel">
      <h2>Latest Logs</h2>
      <ul class="card-grid">
        {logs.map((log) => (
          <li class="card">
            <p class="eyebrow">{log.data.type}</p>
            <h3>
              <a href={`/logs/${log.id}/`}>{log.data.title}</a>
            </h3>
            <p>{log.data.summary}</p>
            <p class="meta">
              <span>{formatDate(log.data.publishedAt)}</span>
              <span>Route: {routesById.get(log.data.primaryRoute)?.data.title ?? log.data.primaryRoute}</span>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section>
    <ul class="card-grid">
      {projects.map((project) => (
        <li class="card">
          <p class="eyebrow">Project</p>
          <h2>
            <a href={`/projects/${project.id}/`}>{project.data.title}</a>
          </h2>
          <p>{project.data.summary}</p>
          <p class="meta">
            <span>Status: {project.data.status}</span>
            {project.data.updatedAt && <span>Updated {formatDate(project.data.updatedAt)}</span>}
            <span>
              Route: {routesById.get(project.data.primaryRoute)?.data.title ?? project.data.primaryRoute}
            </span>
          </p>
        </li>
      ))}
      {routes.map((route) => (
        <li class="card">
          <p class="eyebrow">Route</p>
          <h2>
            <a href={`/routes/${route.id}/`}>{route.data.title}</a>
          </h2>
          <p>{route.data.description}</p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
