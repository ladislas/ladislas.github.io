---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  formatDate,
  isPublishedProject,
  sortProjectsByUpdatedDesc,
  sortRoutesByOrder,
} from '../../lib/content';

const projects = (await getCollection('projects'))
  .filter(isPublishedProject)
  .sort(sortProjectsByUpdatedDesc);
const routes = (await getCollection('routes')).sort(sortRoutesByOrder);
const routesById = new Map(routes.map((route) => [route.id, route]));
---

<BaseLayout title="Projects | Workshop Terminal" description="Project hubs.">
  <section class="hero">
    <p class="eyebrow">Projects</p>
    <h1>Projects</h1>
    <p class="lede">Living hubs for ongoing or finished work.</p>
  </section>

  <section>
    <ul class="card-grid">
      {projects.map((project) => (
        <li class="card">
          <h2>
            <a href={`/projects/${project.id}/`}>{project.data.title}</a>
          </h2>
          <p>{project.data.summary}</p>
          <p class="meta">
            <span>Status: {project.data.status}</span>
            {project.data.updatedAt && <span>Updated {formatDate(project.data.updatedAt)}</span>}
            <span>
              Route: {routesById.get(project.data.primaryRoute)?.data.title ?? project.data.primaryRoute}
            </span>
          </p>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
